{
    "name": "perimetre/perimetre-wp-tools-tests",
    "description": "Test tooling for Perimetre WP Tools. Kept apart from the plugin's own composer.json so the committed vendor/ and its autoloader never load test code.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Perimetre\\WpTools\\": "../src/",
            "Perimetre\\WpTools\\Tests\\": ""
        },
        "files": [
            "Support/wordpress-classes.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
