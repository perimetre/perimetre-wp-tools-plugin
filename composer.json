{
    "name": "perimetre/perimetre-wp-tools",
    "description": "Operational tooling for Perimetre WordPress sites: status endpoint and remote login.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Perimetre",
            "homepage": "https://perimetre.co"
        }
    ],
    "require": {
        "php": ">=8.1",
        "yahnis-elsts/plugin-update-checker": "^5.6"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Perimetre\\WpTools\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test:install": "@composer --working-dir=tests install",
        "test": [
            "@composer --working-dir=tests install --quiet --no-interaction",
            "tests/vendor/bin/phpunit --configuration tests/phpunit.xml.dist"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "autoloader-suffix": "PerimetreWpTools"
    }
}
